{
	"name": "proyecto-viaticos",
	"version": "0.0.0",
	"private": true,
	"description": "Entorno inicial para desarrollar colaborativamente el proyecto de viáticos.",
	"type": "module",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm format:check && pnpm cf-typegen:check",
		"cf-typegen": "wrangler types",
		"cf-typegen:check": "wrangler types --check",
		"deploy": "pnpm build && wrangler deploy",
		"dev": "vite",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"preview": "vite preview",
		"start": "vite",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.8",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "~4.1.0",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
